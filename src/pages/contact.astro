---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | Mood for Life">
  <section class="prose">
    <p class="eyebrow">Contact</p>
    <h1>Contact</h1>
    <p class="lede">
      For speaking, media, book inquiries, or professional correspondence.
    </p>
    <p>
      Replace this placeholder with your preferred contact method. To reduce spam, you may prefer a contact form service rather than publishing your email address directly.
    </p>
    <div class="callout">
      Suggested options: Buttondown, ConvertKit, Formspree, Tally, or a simple email link written in a spam-resistant way.
    </div>
  </section>
</BaseLayout>
