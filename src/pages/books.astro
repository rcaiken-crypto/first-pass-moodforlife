---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Books | Mood for Life">
  <section class="prose">
    <p class="eyebrow">Books</p>
    <h1>Books by Richard C. Aiken</h1>
    <p class="lede">
      Books on clinical presence, mood, cognition, nutrition, self-regulation, and the scientific search for a well-lived life.
    </p>
  </section>

  <section class="book-list">
    <article class="card book-card">
      <div class="book-cover-placeholder">Book cover<br />clinical-presence-cover.jpg</div>
      <div>
        <h2>Clinical Presence</h2>
        <p class="muted">Forthcoming / Routledge</p>
        <p>A practical guide to staying engaged, attentive, and emotionally regulated in demanding clinical encounters.</p>
        <a href="/clinical-presence/">View book page →</a>
      </div>
    </article>

    <article class="card book-card">
      <div class="book-cover-placeholder">Book cover</div>
      <div>
        <h2>Mood for Life</h2>
        <p class="muted">In development</p>
        <p>A mind-body-spirit framework for mood, vitality, meaning, and disciplined self-regulation across the lifespan.</p>
      </div>
    </article>

    <article class="card book-card">
      <div class="book-cover-placeholder">Book cover</div>
      <div>
        <h2>Previous books</h2>
        <p>Add existing titles here with short descriptions, cover images, and purchase links.</p>
      </div>
    </article>
  </section>
</BaseLayout>
