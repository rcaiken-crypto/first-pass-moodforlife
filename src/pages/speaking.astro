---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Speaking & Media | Mood for Life">
  <section class="prose">
    <p class="eyebrow">Speaking & Media</p>
    <h1>Speaking, podcasts, and professional programs</h1>
    <p class="lede">
      Talks and conversations on clinical presence, burnout, mood, vitality, aging, self-regulation, and mind-body-spirit integration from a psychiatrist-scientist's perspective.
    </p>
  </section>

  <section class="grid-2">
    <article class="card">
      <h2>Possible talk topics</h2>
      <ul>
        <li>Clinical presence in high-stress care</li>
        <li>Mindfulness without sentimentality</li>
        <li>Mood, vitality, and aging well</li>
        <li>Psychiatry, biology, and meaning</li>
        <li>The clinician's attention as an instrument of care</li>
      </ul>
    </article>
    <article class="card">
      <h2>Media bio</h2>
      <p>Add a short 75–100 word bio suitable for podcast hosts, event organizers, and publisher pages.</p>
    </article>
  </section>
</BaseLayout>
