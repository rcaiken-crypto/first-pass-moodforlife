---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Essays | Mood for Life">
  <section class="prose">
    <p class="eyebrow">Essays</p>
    <h1>Essays and field notes</h1>
    <p class="lede">
      Short pieces on mood, attention, clinical presence, self-regulation, aging, vitality, and the scientific life.
    </p>
    <p>
      This starter page can later be connected to Markdown essay files, so adding a new essay becomes very easy.
    </p>
  </section>

  <section class="grid-2">
    <article class="card">
      <h2>Clinical presence and attention</h2>
      <p class="muted">Draft essay placeholder</p>
      <p>How sustained attention becomes a clinical skill rather than a personality trait.</p>
    </article>
    <article class="card">
      <h2>Mood as regulation</h2>
      <p class="muted">Draft essay placeholder</p>
      <p>Why mood should be understood as a dynamic regulatory system rather than an isolated feeling.</p>
    </article>
  </section>
</BaseLayout>
