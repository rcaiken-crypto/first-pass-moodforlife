---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Mood for Life | Richard C. Aiken" description="A psychiatrist-scientist's exploration of mood, attention, body, spirit, vitality, and clinical presence.">
  <section class="hero">
    <div>
      <p class="eyebrow">A psychiatrist-scientist's field guide to human vitality</p>
      <h1>Mood is not merely a symptom. It is a life system.</h1>
      <p class="lede">
        Mood for Life explores how human beings regulate attention, emotion, energy, meaning, and vitality across the lifespan — drawing from psychiatry, psychology, science, disciplined physical practice, and contemplative traditions.
      </p>
      <div class="button-row">
        <a class="button" href="/clinical-presence/">Explore Clinical Presence</a>
        <a class="button secondary" href="/books/">View Books</a>
      </div>
    </div>
    <aside class="hero-card">
      <div class="portrait-placeholder">
        Add portrait or Mood for Life image here<br />/public/images/richard-aiken.jpg
      </div>
      <h3>Richard C. Aiken</h3>
      <p class="muted">
        Psychiatrist, scientist, author, former medical director, and lifelong student of self-regulation, vitality, and clinical presence.
      </p>
    </aside>
  </section>

  <section class="section">
    <p class="eyebrow">Core themes</p>
    <h2>Mind, body, and spirit — without abandoning scientific rigor.</h2>
    <div class="grid-3">
      <article class="card">
        <h3>Mind</h3>
        <p>Attention, cognition, mood, diagnostic reasoning, and emotional self-regulation.</p>
      </article>
      <article class="card">
        <h3>Body</h3>
        <p>Exercise, nutrition, sleep, inflammation, energy, aging, and disciplined physical practice.</p>
      </article>
      <article class="card">
        <h3>Spirit</h3>
        <p>Meaning, presence, moral attention, contemplative practice, and the lived experience of healing.</p>
      </article>
    </div>
  </section>

  <section class="section grid-2">
    <article class="card">
      <p class="eyebrow">Forthcoming</p>
      <h2>Clinical Presence</h2>
      <p>
        A practical framework for staying engaged, emotionally regulated, and diagnostically clear without burning out.
      </p>
      <a href="/clinical-presence/">Read more →</a>
    </article>
    <article class="card">
      <p class="eyebrow">Technical notes</p>
      <h2>Mathematics in psychiatry</h2>
      <p>
        A quieter research layer for diagnostic reliability, population heterogeneity, computational psychiatry, and mathematical models of clinical judgment.
      </p>
      <p class="muted">This section can remain unlisted from the main navigation.</p>
    </article>
  </section>
</BaseLayout>
